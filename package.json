{
  "name": "claude-custom",
  "version": "0.0.1",
  "private": true,
  "description": "A visually customizable display head for Claude Code",
  "main": "app/main.js",
  "bin": {
    "claude-custom": "bin/claude-custom.js"
  },
  "scripts": {
    "start": "electron .",
    "host": "node host/host.js",
    "test": "node scripts/with-heavy-lock.js node --test --test-concurrency=2 \"test/**/*.test.js\"",
    "build:helper": "powershell -NoProfile -ExecutionPolicy Bypass -File helper/build.ps1",
    "bench:hooks": "node verify/measure-hook-latency.js",
    "mutate": "stryker run",
    "build:reader": "node build/build-reader.mjs",
    "dist": "electron-builder --config build/electron-builder.yml --win"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@stryker-mutator/core": "^10.0.0",
    "electron": "^33.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2"
  }
}
