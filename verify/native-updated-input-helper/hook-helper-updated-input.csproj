<Project Sdk="Microsoft.NET.Sdk">

  <!-- FF9 Q2 comparison build only. Mirrors helper/hook-helper.csproj's Native
       AOT settings exactly, so the startup floor is comparable and the only
       measured difference is the added stdout write. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>hook-helper-updated-input</AssemblyName>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StackTraceSupport>false</StackTraceSupport>
    <OptimizationPreference>Speed</OptimizationPreference>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="hook-helper-updated-input.cs" />
  </ItemGroup>

</Project>
