node_modules/
dist/
out/

# Forge output — regenerable, and large
portraits/**/*.png
forge/models/
forge/.cache/
forge/outputs/

# Generated at runtime
.harness/
*.log

# .NET build artefacts for the hook helper
helper/bin/
helper/obj/

# Per-project background art (regenerable, deterministic from path)
backgrounds/

forge/.venv/

__pycache__/
*.pyc
.pytest_cache/

# --- sync-docs (gitignore) ---
# The documentation/ folder is mirrored to the Obsidian vault and kept OUT of
# GitHub by default. Only the index README is tracked. To push the docs to
# GitHub instead, delete this block.
# NOTE: CLAUDE_CUSTOM_DESIGN.md and GAMIFICATION_DESIGN.md predate this rule
# and are already tracked, so git keeps tracking them regardless.
documentation/*
!documentation/README.md
# --- end sync-docs (gitignore) ---

# Stryker mutation reports -- 7MB+ of JSON, regenerable with `npm run mutate`.
# Kept on disk as the evidence for a gate result, never committed.
reports/

# Stryker sandbox -- a full copy of the repo, recreated on every run.
.stryker-tmp/

# Written beside a mod by `claude plugin test` / an interactive session (BACKLOG #119 A2); regenerated for the installed CLI.
mods/*/tsconfig.json
mods/*/.claude-plugin/types/
